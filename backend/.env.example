# Template environment — SALIN jadi .env lalu isi nilai asli (file .env JANGAN di-commit)
# DATABASE_URL: dari dashboard Supabase -> Project Settings -> Database -> Connection string (pooler)
DATABASE_URL="postgresql://postgres.USERNAME:SANDI@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Midtrans: dashboard -> Settings -> Access Keys
MIDTRANS_CLIENT_KEY="Mid-client-xxxx"
MIDTRANS_SERVER_KEY="Mid-server-xxxx"

# Admin dashboard (generate sendiri, contoh: python -c "import secrets; print(secrets.token_hex(24))")
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password-kuat-anda"
ADMIN_TOKEN="token-acak-panjang-anda"
