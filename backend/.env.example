# Template environment — SALIN jadi .env lalu isi nilai asli (file .env JANGAN di-commit)
# DATABASE_URL: dari dashboard Supabase -> Project Settings -> Database -> Connection string (pooler)
DATABASE_URL="postgresql://postgres.USERNAME:SANDI@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Midtrans: dashboard -> Settings -> Access Keys
MIDTRANS_CLIENT_KEY="Mid-client-xxxx"
MIDTRANS_SERVER_KEY="Mid-server-xxxx"

# Admin dashboard (generate sendiri, contoh: python -c "import secrets; print(secrets.token_hex(24))")
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password-kuat-anda"
ADMIN_TOKEN="token-acak-panjang-anda"

# Token sesi user (HMAC). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
USER_TOKEN_SECRET="ganti-dengan-random-minimal-32-karakter"
USER_TOKEN_TTL_SECONDS="604800"

# Frontend origin untuk CORS. Isi domain Vercel produksi (dipisah koma bila lebih dari satu).
FRONTEND_ORIGINS="https://your-app.vercel.app"
# Regex untuk preview/tunnel. Persempit ke domain sendiri saat production.
FRONTEND_ORIGIN_REGEX="https://([a-z0-9-]+\.)*(vercel\.app|trycloudflare\.com|ngrok-free\.app|ngrok\.app)"

# Verifikasi signature webhook Midtrans (disarankan true; status API tetap diverifikasi).
MIDTRANS_VERIFY_SIGNATURE="true"
